rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(chat) {
      return isSignedIn() && request.auth.uid in chat.participants;
    }

    // True iff the calling user's profile says their nickname is the official broadcaster's
    // nickname. Used to gate writes on the "official developer channel" so only the user with
    // the well-known nickname can post / update the channel doc.
    function isOfficialBroadcaster() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname == "General_оф";
    }

    // Users: anyone authenticated can read profiles (needed for nickname search);
    // only the owner can write their own profile.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // Nickname registry. The doc id is the lower-cased nickname; the doc stores the owning UID.
    // A user can claim a free nickname or take back one already pointing at their own UID.
    // No one else can write to a claim that points at a different UID.
    match /nicknames/{nicknameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Chats: regular chats are private to participants; "channel" chats are world-readable
    // broadcasts with a single allowed broadcaster (gated by nickname).
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource.data.type == "channel" || isParticipant(resource.data)
      );
      allow create: if isSignedIn() && (
        request.resource.data.type == "channel" ||
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isSignedIn() && (
        isParticipant(resource.data) ||
        (resource.data.type == "channel" && isOfficialBroadcaster())
      );
      // Channels are persistent and never deletable from a client.
      allow delete: if isSignedIn()
        && resource.data.type != "channel"
        && isParticipant(resource.data);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.type == "channel" ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
            (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == "channel"
              && isOfficialBroadcaster()
            ) ||
            (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type != "channel"
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            )
          );
        allow update: if isSignedIn() && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == "channel"
            && isOfficialBroadcaster()
          ) ||
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type != "channel"
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
        );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Statuses: any signed-in user can read recent statuses, owner-only writes.
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Owner can update text/media; anyone signed-in can append themselves to the viewers list.
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Calls: caller and callee can read/write.
    match /calls/{callId} {
      function isParty(call) {
        return isSignedIn() && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId);
      }
      allow read: if isParty(resource.data);
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid;
      allow update: if isParty(resource.data);
      allow delete: if isParty(resource.data);

      match /candidates/{candidateId} {
        allow read, write: if isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
    }
  }
}
